-import torch, torchvision, imageio, os
+import time, torch, torchvision, imageio, os
 import imageio.v3 as iio
 from PIL import Image
 
 
+def _imageio_get_reader_with_retry(path, attempts=10, base_delay=1.0):
+    """imageio_ffmpeg has a 10s hard timeout for ffmpeg's stderr header
+    (imageio_ffmpeg/_io.py: `etime = time.time() + 10.0`). On a busy NFS/AFS
+    mount the first read of a file occasionally exceeds that window and
+    raises `OSError: Could not load meta information`, killing the job mid-
+    epoch. Retry with backoff — the second attempt usually finds the file
+    warm in the page cache."""
+    last_exc = None
+    for i in range(attempts):
+        try:
+            return imageio.get_reader(path)
+        except OSError as e:
+            if "Could not load meta information" not in str(e):
+                raise
+            last_exc = e
+            if i + 1 < attempts:
+                time.sleep(base_delay * (2 ** i))
+    raise last_exc
+
+
 class DataProcessingPipeline:
     def __init__(self, operators=None):
         self.operators: list[DataProcessingOperator] = [] if operators is None else operators
@@ -122,15 +142,20 @@ class LoadVideo(DataProcessingOperator):
         return num_frames
         
     def __call__(self, data: str):
-        reader = imageio.get_reader(data)
+        reader = _imageio_get_reader_with_retry(data)
         num_frames = self.get_num_frames(reader)
         frames = []
-        for frame_id in range(num_frames):
+        # Explicitly cap at self.num_frames to handle videos with extra frames
+        max_frames_to_load = min(num_frames, self.num_frames)
+        for frame_id in range(max_frames_to_load):
             frame = reader.get_data(frame_id)
             frame = Image.fromarray(frame)
             frame = self.frame_processor(frame)
             frames.append(frame)
         reader.close()
+        # Final safety check - ensure we never return more than requested
+        if len(frames) > self.num_frames:
+            frames = frames[:self.num_frames]
         return frames
 
 
